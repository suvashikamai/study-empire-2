# Database (local SQLite file by default — see docs/architecture.md for the
# Postgres/cloud migration path used at real scale)
DATABASE_URL="file:./dev.db"

# Session signing secret — generate with `openssl rand -base64 48`
# NEVER commit a real value. This is the only "credential" Phase 1 needs
# because auth is self-hosted (bcrypt + JWT) instead of a managed provider.
AUTH_SECRET="replace-with-a-long-random-string"

# Optional, for Phase 2+: managed auth provider (Firebase Auth / Auth0 / etc.)
# if/when you migrate off the self-hosted auth in lib/auth.ts
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=

NODE_ENV="development"

